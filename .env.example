# Copy to .env and uncomment the settings you want to change. Everything is optional: the
# commented values are the defaults, so copying this file unchanged changes nothing.
# Docker Compose already sets REDIS_URL, DATA_DIR and API_PORT inside the containers.

# --- Infrastructure ---------------------------------------------------------------------------
# REDIS_URL=redis://localhost:6379/0
# uploads are stored in $DATA_DIR/uploads (shared with workers)
# DATA_DIR=./data

# --- API --------------------------------------------------------------------------------------
# API_PORT=8000
# MAX_UPLOAD_MB=500
# 2 hours
# MAX_DURATION_SECONDS=7200
# above this, uploads get 503 QUEUE_FULL
# MAX_QUEUE_SIZE=100
# PROBE_TIMEOUT_SECONDS=30
# SSE_POLL_INTERVAL_SECONDS=0.5
# SSE_KEEPALIVE_SECONDS=15

# --- Jobs -------------------------------------------------------------------------------------
# finished jobs are kept for 24 hours
# RESULT_TTL_SECONDS=86400
# JOB_TIMEOUT_SECONDS=3600
# DECODE_TIMEOUT_SECONDS=600
# attempts before a job whose worker died is failed
# MAX_ATTEMPTS=2

# --- Worker -----------------------------------------------------------------------------------
# defaults to the hostname (unique per container)
# WORKER_ID=
# HEARTBEAT_INTERVAL_SECONDS=10
# HEARTBEAT_TTL_SECONDS=30
# SWEEP_INTERVAL_SECONDS=30

# --- Model ------------------------------------------------------------------------------------
# Any faster-whisper (CTranslate2) model on the Hugging Face Hub, e.g.:
#   Systran/faster-whisper-tiny | -base | -small | -medium | -large-v3
#   ivrit-ai/whisper-large-v3-ct2  (Hebrew)
# MODEL_NAME=Systran/faster-whisper-small
# auto | cpu | cuda
# DEVICE=auto
# default: float16 on CUDA, int8 on CPU
# COMPUTE_TYPE=
# 0 = let CTranslate2 decide
# CPU_THREADS=0
# BEAM_SIZE=5
# MODEL_WARMUP=true
# optional: higher Hugging Face download rate limits
# HF_TOKEN=

# --- Logging ----------------------------------------------------------------------------------
# DEBUG | INFO | WARNING | ERROR
# LOG_LEVEL=INFO
# text | json (Compose uses json)
# LOG_FORMAT=text
